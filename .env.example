# This template has no usable credentials. Never commit your .env.
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# mysql:// and mysql+pymysql:// supported; URL-encode special characters in passwords.
DATABASE_URL=mysql+pymysql://esc_app:REPLACE_WITH_ENCODED_PASSWORD@127.0.0.1:3306/enterprise_sales_copilot
SESSION_SECRET=
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=esc_business
MINIO_SECRET_KEY=
MINIO_BUCKET=esc-evidence
AI_MODE=mock
KNOWLEDGE_ENABLED=false
ENABLE_DEV_SEED=false
# Core Compose uses a separate generated .local/compose.env; remote .env is preserved.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=enterprise_sales_copilot
MYSQL_USER=esc_app
MYSQL_PASSWORD=
MYSQL_RUNTIME_USER=esc_runtime
MYSQL_RUNTIME_PASSWORD=
MINIO_ROOT_USER=esc_root
MINIO_ROOT_PASSWORD=
