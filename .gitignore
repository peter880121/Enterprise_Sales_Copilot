# Root-level local keys/certificates; fixtures in source/test directories remain visible.
/*.key
/*.pem
/*.p12
/*.pfx
/*.crt
/*.cer
/*.jks
/.ssh/
/.keys/
/.credentials/
/certs/
/credentials/

# Local service volumes and backups; do not ignore SQL source files globally.
/data/
/mysql-data/
/minio-data/
/milvus-data/
/etcd-data/
/backup/
/backups/
/*.db
/*.db-wal
/*.db-shm
/*.sqlite
/*.sqlite-wal
/*.sqlite-shm
/*.sqlite3
/*.sqlite3-wal
/*.sqlite3-shm

# Alternate virtual environment and root-level temporary work directories.
venv/
/tmp/
/temp/
